// SteamPipe app build script for Game Master's Hub.
//
// Replace YOUR_APP_ID / YOUR_DEPOT_ID with the real ids from your
// Steamworks partner page (App Admin -> SteamPipe -> Depots), then run
// steam/build_steam.ps1 or the steam-release GitHub workflow.
//
// "SetLive" left empty on purpose: builds land in Steamworks unpublished,
// you assign them to a branch (e.g. "beta" or "default") in the web UI.
// Put a branch name here only when you are sure every upload should go
// live on that branch automatically.
"AppBuild"
{
	"AppID" "YOUR_APP_ID"
	"Desc" "GMH __VERSION__ (win64)"
	"BuildOutput" "..\build\steam_output\"
	"ContentRoot" "..\build\steam_content\"
	"SetLive" ""

	"Depots"
	{
		"YOUR_DEPOT_ID" "depot_build_windows.vdf"
	}
}
